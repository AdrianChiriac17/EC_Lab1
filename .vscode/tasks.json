{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build lab1",
            "type": "process",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g",
                "${workspaceFolder}/Lab1/main.cpp",
                "-o",
                "${workspaceFolder}/Lab1/lab1"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Lab1"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run lab1 example",
            "type": "process",
            "command": "${workspaceFolder}/Lab1/lab1",
            "windows": {
                "command": "${workspaceFolder}/Lab1/lab1.exe"
            },
            "args": ["${workspaceFolder}/Lab1/test_example.txt"],
            "dependsOn": "Build lab1",
            "options": {
                "cwd": "${workspaceFolder}/Lab1"
            },
            "problemMatcher": []
        },
        {
            "label": "Build lab2",
            "type": "process",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g",
                "${workspaceFolder}/Lab2/main.cpp",
                "-o",
                "${workspaceFolder}/Lab2/lab2"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Lab2"
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "Run lab2 example",
            "type": "process",
            "command": "${workspaceFolder}/Lab2/lab2",
            "windows": {
                "command": "${workspaceFolder}/Lab2/lab2.exe"
            },
            "args": ["${workspaceFolder}/Lab2/test_example.txt"],
            "dependsOn": "Build lab2",
            "options": {
                "cwd": "${workspaceFolder}/Lab2"
            },
            "problemMatcher": []
        }
    ]
}
