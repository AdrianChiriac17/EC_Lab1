{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build lab1",
            "type": "process",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g",
                "${workspaceFolder}/main.cpp",
                "-o",
                "${workspaceFolder}/lab1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run lab1 example",
            "type": "process",
            "command": "${workspaceFolder}/lab1",
            "windows": {
                "command": "${workspaceFolder}/lab1.exe"
            },
            "args": ["${workspaceFolder}/example.txt"],
            "dependsOn": "Build lab1",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
